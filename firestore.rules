rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to read API keys (they're encrypted anyway)
    // In production, you should use Firebase Cloud Functions instead
    match /config/apiKeys {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Allow users to track their own AI query usage
    // The document ID format is: userId_date (e.g., "device123_2024-01-15")
    match /aiQueries/{queryDoc} {
      allow read, write: if request.auth != null;
    }
    
    // Allow anyone to read content (articles, quizzes, emergency scenarios)
    match /content/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow users to read/write their own pet profiles
    match /pets/{petId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow users to read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
